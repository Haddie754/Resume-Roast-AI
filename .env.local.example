# Copy this file to `.env.local` and fill in your real keys.
# .env.local is gitignored and is read by Next.js at runtime.

# AI provider selection: "gemini" (default) | "openai" | "anthropic" (stubs for later)
AI_PROVIDER=gemini

# Google AI Studio key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model name. 1.5 flash is fast & cheap; 1.5 pro is smarter.
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (only needed if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, NEVER expose to the browser.
# Used by the Lemon Squeezy webhook to update user plans (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy webhook signing secret — set this when you create the webhook
# in the Lemon Squeezy dashboard (Settings → Webhooks). Must match exactly.
LEMONSQUEEZY_WEBHOOK_SECRET=
